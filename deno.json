{
  "compilerOptions": { "strict": true },
  "tasks": {
    "check": "deno run --allow-read=. --allow-run=git scripts/check-secrets.mjs && deno run --allow-read=. --allow-run=git scripts/check-repo.mjs",
    "db:test": "deno run --allow-read=supabase/tests --allow-write=supabase/.temp --allow-run=npx scripts/run-db-tests.mjs",
    "db:seed-psgc": "deno run --allow-net=psgc.gitlab.io --allow-write=supabase/.temp --allow-run=npx scripts/seed-psgc.mjs",
    "db:concurrency": "deno run --allow-read=supabase/.temp --allow-write=supabase/.temp --allow-run=npx scripts/check-booking-concurrency.mjs",
    "members:import": "deno run --allow-read --allow-env=USERPROFILE,HOME \"--allow-write=$USERPROFILE\" --allow-net=iohrwwrkhdkmzxntstuu.supabase.co --allow-run=python scripts/import-members.mjs",
    "members:enrich": "deno run --allow-read --allow-env=USERPROFILE,HOME --allow-net=iohrwwrkhdkmzxntstuu.supabase.co --allow-run=python scripts/enrich-members.mjs",
    "members:create-admin": "deno run --allow-read --allow-env=USERPROFILE,HOME \"--allow-write=$USERPROFILE\" --allow-net=iohrwwrkhdkmzxntstuu.supabase.co scripts/create-admin.mjs",
    "db:advisors": "deno run --allow-run=npx scripts/check-advisors.mjs",
    "db:backup": "deno run --allow-read=. --allow-env=USERPROFILE,HOME \"--allow-write=$USERPROFILE/cpc-backups\" --allow-run=npx,git scripts/backup-db.mjs",
    "dev": "deno run --allow-net=127.0.0.1:8099 --allow-read=web --allow-env=PORT scripts/dev-server.mjs",
    "test": "deno test --no-check --allow-read=web tests/unit",
    "lint": "deno lint",
    "fmt": "deno fmt --check"
  },
  "fmt": {
    "include": ["deno.json", "scripts/", "web/", "tests/", ".github/"],
    "exclude": [
      "web/**/*.md",
      "scripts/**/*.md",
      ".github/**/*.md",
      "web/vendor/"
    ]
  },
  "lint": { "exclude": [".claude/", "supabase/.temp/", "web/vendor/"] }
}
